# Python
__pycache__/
*.py[cod]
*$py.class
*.so
# ...except the bundled Sigil build, which is a shipped artifact rather than a
# local compilation product. Without this negation the blanket *.so above drops
# it silently: the tree would look complete, every build would package a
# library that is not there, and Switch identification would fall back to
# reading filenames on every machine but the one that ran build_sigil.sh.
!engine/romm_sync_engine/bin/*.so
.Python
build/AppDir/
build/RomM-*.AppImage
build/*.zsync
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Application specific
*.log
config.ini
cache/
temp/

# Build artifacts
AppDir/
*.AppImage
*.zsync
appimagetool*

# Screenshots (except assets)
screenshot_*.png
screen_*.png

# Temporary files
*.tmp
*.temp
.cache/

# User configuration and data
.config/
user_data/
local_settings.ini

# Development tools
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json

# Distribution and packaging
*.deb
*.rpm
*.tar.gz
*.zip
releases/

# Claude Code
.claude/
.romm-ref/

node_modules/

# local dev
.venv/

# desktop packaging outputs
desktop/runtime/
desktop/release/

# Local libsigil build (scripts/build_sigil.sh). The build directory is scratch;
# the copy the script installs into the engine package is a SHIPPED artifact and
# is committed -- see the *.so negation at the top of this file.
sigil-build/

# Test-only virtualenv, built on demand by engine/tests/run.sh when no
# interpreter on the machine has the engine dependencies. Not covered by the
# .venv/ rule above -- that matches the exact name, not this suffixed one.
engine/.venv-tests/

# Build-time embedded release token (scripts/embed-token.sh)
app/ludo_app/_token.py
