  "homepage": "https://github.com/rommapp/ludo#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
